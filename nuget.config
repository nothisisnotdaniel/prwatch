<?xml version="1.0" encoding="utf-8"?>
<!-- RoomKit comes only from the local folder feed that ControlRoom's release fills (see ControlRoom/docs/roomkit.md);
     every other package only from nuget.org, so a nuget.org package named RoomKit is never picked up. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="roomkit" value="%HOME%/Library/Application Support/RoomKit/feed" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="roomkit">
      <package pattern="RoomKit" />
    </packageSource>
  </packageSourceMapping>
</configuration>
