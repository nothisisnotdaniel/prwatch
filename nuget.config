<?xml version="1.0" encoding="utf-8"?>
<!-- RoomKit comes only from GitHub Packages (source github); every other package only from nuget.org, so a
     nuget.org package named RoomKit is never picked up. No credentials here: set NuGetPackageSourceCredentials_github
     locally (README.md) and in CI (GITHUB_TOKEN, on the Restore steps only). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="github" value="https://nuget.pkg.github.com/nothisisnotdaniel/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="github">
      <package pattern="RoomKit" />
    </packageSource>
  </packageSourceMapping>
</configuration>
